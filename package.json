{
  "name": "dithered-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter playground-web dev",
    "build": "pnpm --filter dithered build",
    "build:playground": "pnpm --filter playground-web build",
    "typecheck": "pnpm --recursive --parallel typecheck",
    "test": "pnpm --filter dithered test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
